# 数据库路径（默认：data/sequoia_v2.db）
DB_PATH=data/sequoia_v2.db

# 数据起始日期（默认：2024-01-01）
START_DATE=2024-01-01

# 任务与选股结果库（默认：data/tasks.db）。与行情库物理隔离，服务启动时自动创建。
TASK_DB_PATH=data/tasks.db

# 历史任务保留条数（默认：200）。超出的旧任务及其信号在启动时裁剪，只动任务库不动行情库。
TASK_HISTORY_LIMIT=200

# 每个任务落库的日志尾部行数上限（默认：200）。防止长任务日志撑大 tasks.db。
TASK_LOG_TAIL_LINES=200

# API 监听地址（默认：127.0.0.1）。
# 风险说明：API_KEY 留空时服务完全无鉴权，此时绝不要把这个值改成 0.0.0.0——
# 局域网内任何人都能触发跑批、读走全部数据。保持回环是本项配置的默认安全边界。
API_HOST=127.0.0.1

# API 监听端口（默认：8000）。run_server.py 与 uvicorn 启动都读这两个值。
API_PORT=8000

# API 鉴权 Key（默认：空，即不启用鉴权）。请求需携带请求头 X-API-Key: <此值>。
# 这是本服务的**唯一登录凭据**：浏览器在登录页输入的就是它，换取 session cookie，
# 因此泄露它等于交出整个服务的控制权（可触发跑批、读走全部数据）——按密码对待。
# 风险说明：留空 = 整个鉴权层失效，所有 /api/* 接口免鉴权（本地开发语义，启动时会打 WARNING）；
# 此时 API_HOST 必须是 127.0.0.1，否则局域网内任何人都能直接调用。
API_KEY=

# 登录会话有效期（秒，默认：604800 即 7 天）。T7 的 session cookie Max-Age 与此同源。
# 不设滑动过期：到期就得重新登录一次。服务重启会清空进程内会话表，所有人需重新登录
# （单进程部署是本项目前提，见 03-frontend-and-auth.md §3/§9）。
SESSION_TTL_SECONDS=604800

# 前端静态产物目录（默认：frontend/out，相对启动时的当前工作目录）。
# FastAPI 会把该目录挂到根路径，使页面与 API 同端口同源；目录不存在时只记一条 WARNING
# 并继续以"只提供 API"的形态启动（T8 执行 cd frontend && npm run build 才会产出该目录）。
FRONTEND_DIST_PATH=frontend/out

# 是否托管前端静态产物（默认：true）。
# 置为 false 的用途：只跑 API 的进程（或产物由 nginx 等外部托管的开发机）。风险说明：
# 关掉只影响页面能否访问，不影响鉴权——/api/* 仍然照 API_KEY 判定。
SERVE_FRONTEND=true

# 调度器总开关（默认：false）。
# 风险说明：置为 true 后服务会真的按 SCHEDULE_CRON 定时执行跑批并向下面的
# 飞书 Webhook 推送消息（约束 §6：消息不可撤回）。默认关闭，防止一 clone 一启动就到点轰炸群。
SCHEDULER_ENABLED=false

# 跑批调度时间（默认：工作日晚 7 点 15 分；标准 5 段 cron：分 时 日 月 周）。
SCHEDULE_CRON=15 19 * * 1-5

# 调度与所有时间戳使用的时区（默认：Asia/Shanghai）。
# 注意：任务层时间戳（sequoia_x/task/models.py）直接读本环境变量，与 Settings.timezone
# 同名不同源——只在 .env 里设置这一处即可两边同时生效，换环境时不要只改一边。
TIMEZONE=Asia/Shanghai

# 默认飞书 Webhook URL（必填，作为 fallback）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-default-token

# 策略专属 Webhook（可选，格式：STRATEGY_WEBHOOK_<策略标识>=<URL>）
# 未配置的策略将自动使用默认 FEISHU_WEBHOOK_URL
STRATEGY_WEBHOOK_MA_VOLUME=https://open.feishu.cn/open-apis/bot/v2/hook/your-ma-volume-token
STRATEGY_WEBHOOK_TURTLE=https://open.feishu.cn/open-apis/bot/v2/hook/your-turtle-token
STRATEGY_WEBHOOK_FLAG=https://open.feishu.cn/open-apis/bot/v2/hook/your-flag-token
STRATEGY_WEBHOOK_SHAKEOUT=https://open.feishu.cn/open-apis/bot/v2/hook/your-shakeout-token
STRATEGY_WEBHOOK_LIMIT_DOWN=https://open.feishu.cn/open-apis/bot/v2/hook/your-limit-down-token
STRATEGY_WEBHOOK_RPS=https://open.feishu.cn/open-apis/bot/v2/hook/your-rps-token
STRATEGY_WEBHOOK_PRIVATE_PLACEMENT=https://open.feishu.cn/open-apis/bot/v2/hook/your-private-placement-token
